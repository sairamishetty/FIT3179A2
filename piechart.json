{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Electricity usage by type across multiple years",
  "title": "Change in electricity sources over time",
  "data": {
    "url": "https://raw.githubusercontent.com/sairamishetty/FIT3179A2/main/piedata.json"
  },
  "transform": [
    {
      "window": [{"op": "sum", "field": "Value", "as": "TotalValue"}],
      "groupby": ["Year"],
      "frame": [null, null]
    },
    {"calculate": "datum.Value / datum.TotalValue * 100", "as": "Percentage"}
  ],
  "facet": {
    "field": "Year",
    "type": "ordinal"
  },
  "spec": {
    "width": 185,
    "height": 300,
    "layer": [
      {
        "mark": {"type": "arc", "innerRadius": 50},
        "encoding": {
          "theta": {"field": "Value", "type": "quantitative", "stack": true},
          "color": {
            "field": "electricityType",
            "type": "nominal",
            "scale": {
              "domain": [
                "Coal",
                "Natural Gas",
                "Hydro",
                "Geothermal",
                "Solar",
                "Wind",
                "Biofuels",
                "Oil"
              ],
              "range": [
                "#4B4B4B",
                "#FFAA00",
                "#1F78B4",
                "#6DBE45",
                "#FFD700",
                "#A9DFF7",
                "#8DB600",
                "#B5651D"
              ]
            }
          },
          "tooltip": [
            {"field": "electricityType", "type": "nominal", "title": "Source"},
            {
              "field": "Percentage",
              "type": "quantitative",
              "format": ".1f",
              "title": "% of usage"
            }
          ]
        }
      },
      {
        "mark": {"type": "text", "radiusOffset": 15},
        "encoding": {
          "text": {
            "field": "Percentage",
            "type": "quantitative",
            "format": ".1f"
          },
          "theta": {"field": "Value", "type": "quantitative", "stack": true}
        }
      },
      {
        "mark": {"type": "text", "fontSize": 25, "fontWeight": "bold"},
        "encoding": {"text": {"field": "Year"}}
      },
      {
        "mark": {
          "type": "text",
          "dx": 63,
          "dy": 100,
          "fontSize": 8,
          "fontStyle": "italic",
          "color": "black"
        },
        "encoding": {
          "text": {"value": "Greatest drop in Coal"},
          "facet": {"field": "Year", "type": "ordinal"}
        },
        "transform": [{"filter": "datum.Year == 2022"}]
      },
      {
        "mark": {
          "type": "text",
          "dx": -60,
          "dy": -100,
          "fontSize": 8,
          "fontStyle": "italic",
          "color": "black"
        },
        "encoding": {
          "text": {"value": "Greatest increase in solar"},
          "facet": {"field": "Year", "type": "ordinal"}
        },
        "transform": [{"filter": "datum.Year == 2022"}]
      }
    ]
  },
  "spacing": 0,
  "config": {
    "arc": {"stroke": "#fff"},
    "text": {"fontSize": 0}
  }
}